# ============================================================================
# PostPilot — environment variables
#
# Copy to `.env` (gitignored) for local use. In CI these are GitHub Actions
# repository secrets, one secret per value — never a structured/JSON blob,
# so any single token can be rotated without touching the others.
#
# `postpilot doctor` validates every value in this file.
# ============================================================================

# ---------------------------------------------------------------------------
# Google — service account only (no browser OAuth flow for Google)
# ---------------------------------------------------------------------------
# The FULL contents of the service-account JSON key, on one line.
# Locally you may instead point GOOGLE_SERVICE_ACCOUNT_FILE at a path.
# The service account's client_email must be granted:
#   - Editor on the Google Sheet
#   - Viewer (at least) on every brand's Drive folder
# Service accounts cannot own Drive files, so you create and share them by hand.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional local-only alternative to the above (path to the .json key file):
GOOGLE_SERVICE_ACCOUNT_FILE=

# Phase 0 only. Lets the spike check Drive folders before the _Brands tab is
# populated: comma-separated slug=folder_id pairs. Phase 1 reads the real
# values from _Brands and this is deleted.
# DRIVE_FOLDERS=acme-realty=1AbC...,beta-living=1XyZ...

# The long ID from the Sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=

# ---------------------------------------------------------------------------
# Cloudflare R2 — public media bucket behind a custom domain
# ---------------------------------------------------------------------------
# Meta and LinkedIn fetch media by URL, so uploaded objects must be publicly
# readable. A 60-day lifecycle rule on the bucket expires them automatically.
#
# The API token needs "Object Read & Write" on the bucket. A read-only token
# still passes HeadBucket and then fails every PutObject with AccessDenied,
# which looks like a credential problem and is not.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL, no trailing slash.
# We use the *.r2.dev development URL (no custom domain). It is rate-limited
# and unsupported for production traffic, but ample at 20-50 posts/week.
# Swapping in a custom domain later changes this line and nothing else.
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Telegram — daily summary at 09:00 Asia/Karachi  (OPTIONAL)
# ---------------------------------------------------------------------------
# Leaving these blank is fully supported. `doctor` warns rather than fails,
# and `postpilot summary` writes the daily digest to the _Log tab instead,
# so the summary is never silently lost. Publishing never depends on these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Meta (Facebook + Instagram)
# ---------------------------------------------------------------------------
# App-level, used by `postpilot auth meta` to mint long-lived Page tokens.
META_APP_ID=
META_APP_SECRET=

# Per brand: a LONG-LIVED Page Access Token.
# "Long-lived" is not optional: a short-lived token from the Graph API Explorer
# expires within hours and cannot drive an unattended scheduler. A correct one
# reports NO expiry at all. Exchange:
#   GET /oauth/access_token?grant_type=fb_exchange_token&client_id=$META_APP_ID
#       &client_secret=$META_APP_SECRET&fb_exchange_token=<short_lived_user_token>
#   then GET /me/accounts with the result and take the Page's access_token.
# <SLUG> = the brand's Slug from the _Brands tab, upper-cased, "-" -> "_".
# The same token serves both the Facebook Page and the Instagram Business
# account linked to it. Required scopes:
#   pages_show_list, pages_read_engagement, pages_manage_posts,
#   instagram_basic, instagram_content_publish, business_management
# META_PAGE_TOKEN_ACME_REALTY=

# ---------------------------------------------------------------------------
# LinkedIn — ONE token for every page (access pending; Phase 6)
# ---------------------------------------------------------------------------
# A single member token administers every Company Page in the account, so
# these are NOT per brand. Only the org URN is per brand, and that lives in
# the _Brands tab.  Scope: w_organization_social (+ r_organization_social
# for reconciliation). Access token ~60 days, refresh token ~1 year.
# `postpilot auth linkedin` refreshes automatically when a refresh token
# is present and prints the new values for updating the secrets.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# ISO-8601 UTC, e.g. 2026-11-21T00:00:00Z — drives the 7-day expiry warning.
LINKEDIN_TOKEN_EXPIRES=
